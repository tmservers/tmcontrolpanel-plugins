{{#content "globals"}}
#Struct K_TeamView {
  Text name;
  Text color;
  Text logo;
  Integer points;
  Integer roundPoints;
}

#Struct K_TeamScoreState {
  K_TeamView[] teams;
  Integer leader;
  Integer pointsLimit;
  Text status;
  Text centerLogo;
}
{{/content}}

{{#content "script"}}
Integer HexDigit(Text char) {
  declare Text digits = "0123456789ABCDEF";
  for (i, 0, 15) {
    if (TL::SubText(digits, i, 1) == char) return i;
  }
  return 0;
}

Real HexChannel(Text hex, Integer at, Integer width) {
  declare Integer value = HexDigit(TL::SubText(hex, at, 1));
  if (width == 1) return ML::ToReal(value * 17) / 255.;
  return ML::ToReal(value * 16 + HexDigit(TL::SubText(hex, at + 1, 1))) / 255.;
}

// Configured hex color, else the in-game team color
Vec3 TeamColor(Text hex, Integer side) {
  declare Text upper = TL::ToUpperCase(hex);
  if (TL::Length(upper) == 3) {
    return <HexChannel(upper, 0, 1), HexChannel(upper, 1, 1), HexChannel(upper, 2, 1)>;
  }
  if (TL::Length(upper) == 6) {
    return <HexChannel(upper, 0, 2), HexChannel(upper, 2, 2), HexChannel(upper, 4, 2)>;
  }
  if (Teams.count > side) return Teams[side].ColorPrimary;
  if (side == 0) return <0., 0., 1.>;
  return <1., 0., 0.>;
}

// Breaks a name that doesn't fit into two lines at the last word that still fits
Text WrapName(CMlLabel label, Text name, Real maxWidth) {
  if (label.ComputeWidth(name) <= maxWidth) return name;
  declare Text first = "";
  declare Text second = "";
  foreach (word in TL::Split(" ", name)) {
    if (second == "") {
      declare Text candidate = word;
      if (first != "") candidate = first ^ " " ^ word;
      if (first == "" || label.ComputeWidth(candidate) <= maxWidth) {
        first = candidate;
        continue;
      }
      second = word;
    } else {
      second = second ^ " " ^ word;
    }
  }
  if (second == "") return first;
  return first ^ "\n" ^ second;
}

Void UpdateSide(CMlFrame frame, K_TeamView team, Integer side, Integer leader, Integer pointsLimit) {
  declare Vec3 color = TeamColor(team.color, side);
  declare Text suffix = "-" ^ side;

  (frame.GetFirstChild("stripe" ^ suffix) as CMlQuad).BgColor = color;
  (frame.GetFirstChild("score" ^ suffix) as CMlLabel).SetText(TL::ToText(team.points));


  declare nameLabel <=> (frame.GetFirstChild("name" ^ suffix) as CMlLabel);
  nameLabel.SetText(WrapName(nameLabel, team.name, nameLabel.Size.X));
  // The logo covers the team color square on the outer end
  declare logo <=> (frame.GetFirstChild("logo" ^ suffix) as CMlQuad);
  if (team.logo != "") {
    logo.ImageUrl = team.logo;
    logo.Show();
  } else {
    logo.Hide();
  }

  // Progress toward the points limit, filling toward the centre
  declare barBg <=> (frame.GetFirstChild("bar-bg" ^ suffix) as CMlQuad);
  declare bar <=> (frame.GetFirstChild("bar" ^ suffix) as CMlQuad);
  if (pointsLimit <= 0) {
    barBg.Hide();
    bar.Hide();
    return;
  }
  barBg.Show();
  bar.Show();
  bar.BgColor = color;
  declare Real width = 30. * ML::Min(ML::ToReal(team.points) / ML::ToReal(pointsLimit), 1.);
  declare Real x = 74.;
  if (side == 0) x = 40. - width;
  AnimMgr.Add(bar, "<quad pos='" ^ x ^ " -9.25' size='" ^ width ^ " 0.75' />", 400, CAnimManager::EAnimManagerEasing::ExpInOut);
}

Void UpdateScoreboard(Text json) {
  declare K_TeamScoreState state;
  if (!state.fromjson(json) || state.teams.count < 2) return;

  declare frame <=> (Page.MainFrame.GetFirstChild("team-score") as CMlFrame);
  UpdateSide(frame, state.teams[0], 0, state.leader, state.pointsLimit);
  UpdateSide(frame, state.teams[1], 1, state.leader, state.pointsLimit);

  // A bar under the round leader's score, sliding over when the lead changes
  declare leaderBar <=> (frame.GetFirstChild("leader-bar") as CMlQuad);
  if (state.leader == 0 || state.leader == 1) {
    declare Real barX = 40.;
    if (state.leader == 1) barX = 62.;
    if (!leaderBar.Visible) {
      leaderBar.RelativePosition_V3.X = barX;
      leaderBar.Show();
    }
    AnimMgr.Add(leaderBar, "<quad pos='" ^ barX ^ " -9' />", 300, CAnimManager::EAnimManagerEasing::QuadInOut);
  } else {
    leaderBar.Hide();
  }

  // A center logo replaces the "vs" text
  declare centerLogo <=> (frame.GetFirstChild("center-logo") as CMlQuad);
  declare versus <=> (frame.GetFirstChild("versus") as CMlLabel);
  if (state.centerLogo != "") {
    centerLogo.ImageUrl = state.centerLogo;
    centerLogo.Show();
    versus.Hide();
  } else {
    centerLogo.Hide();
    versus.Show();
  }

  (frame.GetFirstChild("status") as CMlLabel).SetText(state.status);
  declare statusBg <=> (frame.GetFirstChild("status-bg") as CMlQuad);
  statusBg.Visible = state.status != "";
}
{{/content}}

{{#content "main"}}
declare Text TeamScoreJson for This = """{{{ default data.stateJson '{}' }}}""";
declare Integer LastTeamScoreUpdate for This = -1;
declare Integer lastUpdate = LastTeamScoreUpdate;
declare Integer lastRefresh = Now;
UpdateScoreboard(TeamScoreJson);
{{/content}}

{{#content "loop"}}
// Also refresh every few seconds: the in-game team colors can change without new data
if (LastTeamScoreUpdate != lastUpdate || Now - lastRefresh > 5000) {
  lastUpdate = LastTeamScoreUpdate;
  lastRefresh = Now;
  UpdateScoreboard(TeamScoreJson);
}
{{/content}}
{{/extend}}
