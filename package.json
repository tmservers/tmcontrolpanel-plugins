{
  "name": "tmcontrolpanel-plugins",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "bun scripts/setup.ts",
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "bun run typecheck && bun run test && bun run build && bun .controlpanel/packages/plugin-sdk/src/cli/main.ts registry --registry . --check",
    "site": "bun .controlpanel/packages/plugin-sdk/src/cli/main.ts registry --registry . --out _site",
    "dev": "bun run site && bun scripts/serve.ts",
    "wiki:publish": "bun scripts/publish-wiki.ts",
    "bench": "vitest run --config bench/vitest.config.ts"
  }
}
